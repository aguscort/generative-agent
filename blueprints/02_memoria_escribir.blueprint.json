        "method": "post",
        "timeout": "40",
        "contentType": "json",
        "inputMethod": "jsonString",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "jsonStringBodyContent": "{\"agente\": \"{{1.agente}}\", \"chat_id\": \"{{1.chat_id}}\", \"importancia_acumulada\": {{7.result}}}",
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
