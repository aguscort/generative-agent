        "notes": [
            {
                "moduleIds": [
                    1
                ],
                "content": "<p><strong>Refinar</strong></p><p>Recibe un paso fallido de Observar. Si ya lleva 2 correcciones o 5 pasos, da el compromiso por fallido. Si no, Gemini decide: corregir (vuelve a Actuar con una instrucción), aplazar o fallido. Si falla una promesa a un chat, crea el compromiso de avisarle. Desactivado hasta terminar la ejecución.</p>",
                "isFilterNote": false,
                "metadata": {
                    "color": "#9138FE"
                }
            }
