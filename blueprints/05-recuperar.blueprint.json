        {
            "id": 5,
            "module": "code:ExecuteCode",
            "version": 1,
            "parameters": {},
            "mapper": {
                "input": [
                    {
                        "name": "consulta_emb",
                        "value": "{{10.text}}"
                    },
                    {
                        "name": "registros",
                        "value": "{{4.text}}\n{{16.text}}"
                    },
                    {
                        "name": "k",
                        "value": "{{ifempty(1.k; 10)}}"
                    },
                    {
                        "name": "ahora",
                        "value": "{{now}}"
                    },
                    {
                        "name": "n",
                        "value": "{{ifempty(1.n; 0)}}"
                    },
                    {
                        "name": "chat",
                        "value": "{{1.chat_id}}"
                    },
                    {
                        "name": "ventana",
                        "value": "{{12.ventana}}"
                    },
                    {
                        "name": "usuario",
                        "value": "{{1.usuario}}"
                    },
                    {
                        "name": "agente",
                        "value": "{{1.agente}}"
                    },
                    {
                        "name": "consulta",
                        "value": "{{1.consulta}}"
                    }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// [Human_proxy] Recuperación de memorias (Park et al., 2023, §4.1)\n// score = recencia + importancia + relevancia (alfa = 1), cada componente normalizado min-max a [0,1]\n// recencia: decaimiento exponencial 0.995 por hora desde el último acceso\n// relevancia: similitud coseno entre el embedding de la consulta y el de cada memoria\nconst { consulta_emb, registros, k, ahora, n, chat, ventana, usuario, agente, consulta } = input;\n\n// Los vectores llegan como texto; se extraen los números con regex (Make no siempre los serializa como JSON válido)\nconst vec = t => (String(t || '').match(/-?\\d+(?:\\.\\d+)?(?:e[-+]?\\d+)?/gi) || []).map(Number);\n// Una línea por consulta, cada una con su vector\nconst qs = String(consulta_emb || '').split('\\n').map(vec).filter(v => v.length);\nif (!qs.length) qs.push([]);\nconst lineas = String(registros || '').split('\\n').map(l => l.trim()).filter(Boolean);\nconst recs = [];\n// Dos lecturas (últimos 300 y reflexiones o importantes): un recuerdo puede venir en las dos, se cuenta una vez\nconst vistos = new Set();\nfor (const l of lineas) { try { const o = JSON.parse(l); if (o && o.id && !vistos.has(o.id)) { vistos.add(o.id); recs.push(o); } } catch (e) { /* línea corrupta: se ignora */ } }\nconst kk = parseInt(k, 10); const K = isNaN(kk) ? 10 : Math.max(0, kk);\nconst nn = parseInt(n, 10); const N = isNaN(nn) ? 0 : Math.max(0, nn);\nconst now = ahora ? new Date(ahora) : new Date();\n\nconst coseno = (a, b) => {\n  if (!Array.isArray(a) || !Array.isArray(b) || !a.length || a.length !== b.length) return 0;\n  let p = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) { p += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }\n  return na && nb ? p / (Math.sqrt(na) * Math.sqrt(nb)) : 0;\n};\n\nconst base = recs.map(r => {\n  const horas = Math.max(0, (now - new Date(r.acc)) / 3.6e6);\n  return {\n    id: r.id, memoria: r.txt, tipo: r.tipo, creado: r.creado,\n    importancia: Number(r.imp) || 0,\n    recencia: isFinite(horas) ? Math.pow(0.995, horas) : 0,\n    emb: vec(r.emb),\n  };\n});\n\nconst minmax = v => { const min = Math.min(...v), max = Math.max(...v); return x => max > min ? (x - min) / (max - min) : 0; };\nconst nRec = minmax(base.map(f => f.recencia));\nconst nImp = minmax(base.map(f => f.importancia));\n\n// Ranking de una consulta: recencia e importancia son comunes; la relevancia depende del vector de la consulta\nconst rank = q => {\n  const rel = base.map(f => coseno(q, f.emb));\n  const nRel = minmax(rel);\n  const filas = base.map((f, i) => ({ f, rec: nRec(f.recencia), imp: nImp(f.importancia), rel: nRel(rel[i]) }));\n  filas.forEach(x => { x.score = x.rec + x.imp + x.rel; });\n  filas.sort((a, b) => b.score - a.score);\n  const top = filas.slice(0, K).map(x => ({\n    id: x.f.id, memoria: x.f.memoria, tipo: x.f.tipo, creado: x.f.creado,\n    score: +x.score.toFixed(4), recencia: +x.rec.toFixed(4),\n    importancia: +x.imp.toFixed(4), relevancia: +x.rel.toFixed(4),\n  }));\n  return {\n    memorias: top,\n    texto: top.map((m, i) => `${i + 1}. ${m.memoria}`).join('\\n'),\n    texto_ids: top.map(m => `(${m.id}) ${m.memoria}`).join('\\n'),\n  };\n};\nconst resultados = qs.map(rank);\nconst { memorias: top, texto, texto_ids } = resultados[0];\n\n// Mensajes anteriores: los N últimos de la ventana del chat (caché), del más antiguo al más reciente\nconst VENTANA = 6;\nlet previa = [];\ntry { const v = JSON.parse(String(ventana || '[]')); if (Array.isArray(v)) previa = v.map(String); } catch (e) { /* ventana corrupta: se empieza de cero */ }\nconst mensajes = N ? previa.slice(-Math.min(N, VENTANA)).join('\\n') : '';\n// Solo en la llamada de conversación (n > 0) se añade el mensaje actual a la ventana\nconst entrada = `${usuario || 'Usuario'} le dijo a ${agente || 'el agente'}: «${consulta || ''}»`;\nconst ventana_nueva = JSON.stringify(N ? [...previa, entrada].slice(-VENTANA) : previa.slice(-VENTANA));\n\n// Último acceso (Park): los recuperados se marcan en lotes de 10, el máximo de Airtable por llamada\nconst validos = [...new Set(resultados.flatMap(r => r.memorias.map(m => m.id)))].filter(id => /^rec[A-Za-z0-9]{14}$/.test(id));\nconst sello = isNaN(now.getTime()) ? new Date().toISOString() : now.toISOString();\nconst lote = l => JSON.stringify({ records: l.map(id => ({ id, fields: { \"__CAMPO_Ultimo_acceso__\": sello } })) });\nconst lotes = [];\nfor (let i = 0; i < validos.length; i += 10) lotes.push(lote(validos.slice(i, i + 10)));\n\nreturn {\n  ids: top.map(m => m.id),\n  lotes,\n  ventana_nueva,\n  texto,\n  texto_ids,\n  mensajes,\n  total_evaluadas: base.length,\n  respuesta: JSON.stringify({ memorias: top, texto, texto_ids, mensajes, total_evaluadas: base.length, resultados }),\n};"
            },
