                    "imageConfig": {},
                    "responseSchema": "{\"type\":\"object\",\"properties\":{\"examen\":{\"type\":\"string\"},\"curso_accion\":{\"type\":\"string\"},\"acto\":{\"type\":\"string\",\"enum\":[\"REQUEST\",\"UNREQUEST\",\"INFORM\",\"NINGUNO\"]},\"accion\":{\"type\":\"string\"},\"dia\":{\"type\":\"string\"},\"hora\":{\"type\":\"string\"},\"fin\":{\"type\":\"string\"},\"condicion\":{\"type\":\"string\"},\"simbolos\":{\"type\":\"string\"},\"contenido\":{\"type\":\"string\"},\"libera\":{\"type\":\"string\"},\"repite\":{\"type\":\"string\"},\"vetado_por\":{\"type\":\"string\"},\"informe\":{\"type\":\"string\"},\"respuesta\":{\"type\":\"string\"}},\"required\":[\"examen\",\"curso_accion\",\"acto\",\"accion\",\"dia\",\"hora\",\"fin\",\"condicion\",\"simbolos\",\"contenido\",\"libera\",\"repite\",\"vetado_por\",\"informe\",\"respuesta\"],\"propertyOrdering\":[\"examen\",\"curso_accion\",\"acto\",\"accion\",\"dia\",\"hora\",\"fin\",\"condicion\",\"simbolos\",\"contenido\",\"libera\",\"repite\",\"vetado_por\",\"informe\",\"respuesta\"]}",
