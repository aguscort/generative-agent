                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Token correcto",
                "conditions": [
                    [
                        {
                            "a": "{{1.token}}",
                            "b": "<TOKEN>",
                            "o": "text:equal"
                        }
                    ]
                ]
            },
            "mapper": {
                "scope": "roundtrip",
                "variables": [
                    {
                        "name": "ob_ok",
                        "value": "{{switch(1.herramienta; \"cotizar\"; if(contains(1.resultado; \"precios\"); if(contains(1.resultado; \"Accepted\"); \"no\"; \"si\"); \"no\"); \"recordar\"; if(contains(1.resultado; \"memorias\"); \"si\"; \"no\"); \"buscar\"; if(1.resultado; if(contains(1.resultado; \"NO_ENCONTRADO\"); \"no\"; \"si\"); \"no\"); \"calcular\"; if(1.resultado; \"si\"; \"no\"); \"cartera\"; \"si\"; \"preguntar\"; if(contains(1.resultado; \"VETADO\"); \"vetado\"; if(contains(1.resultado; \"enviada\"); \"si\"; \"no\")); \"enviar\"; if(contains(1.resultado; \"VETADO\"); \"vetado\"; if(contains(1.resultado; \"enviado\"); \"si\"; \"no\")); \"no\")}}"
                    },
                    {
                        "name": "ob_hist",
                        "value": "{{1.historial}}{{newline}}Paso {{1.paso}}: {{1.herramienta}} ({{1.parametros}}). Motivo: {{1.motivo_paso}}. Resultado: {{substring(1.resultado; 0; 600)}}"
                    },
                    {
                        "name": "ob_paso_sig",
                        "value": "{{parseNumber(ifempty(1.paso; \"1\"); \".\") + 1}}"
                    }
                ]
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
