          "version": 1,
          "metadata": {
            "designer": {
              "x": 0,
              "y": 150
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "base": "<AIRTABLE_BASE_ID>",
        "sort": [
          {
            "field": "Plan_inicio",
            "direction": "asc"
          }
        ],
        "table": "<AIRTABLE_TABLE_ID>",
        "fields": [
          "Memoria",
          "Plan_inicio"
        ],
        "formula": "AND({Agente}=\"{{1.agente}}\", {Chat_ID}=\"GLOBAL\", {Tipo}=\"evento\", IS_AFTER({Plan_inicio}, DATEADD(NOW(), -120, 'minutes')), NOT(IS_AFTER({Plan_inicio}, DATEADD(NOW(), -60, 'minutes'))))",
        "maxRecords": "5",
        "useColumnId": false,
        "formulaField": "formula"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "onerror": [
        {
          "id": 902,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 300,
              "y": 150
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "module": "gemini-ai:createACompletionGeminiPro",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "filter": {
        "name": "Hay un evento que revisar",
        "conditions": [
          [
            {
              "a": "{{2.id}}",
              "o": "exist"
            },
            {
              "a": "{{1.resumen}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "model": "gemini-3.8-flash",
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "Evento financiero previsto para hoy: {{2.Memoria}}\n\nBusca el resultado de este evento: el dato publicado, la decisión tomada o las cifras presentadas, y la reacción inmediata del mercado si la hay. Si todavía no se ha publicado, responde únicamente: NO_PUBLICADO\nSi se ha publicado, responde en un máximo de 60 palabras, con las cifras exactas, y termina con la fuente entre paréntesis.",
                "type": "text"
              }
            ]
          }
        ],
        "generationConfig": {
          "imageConfig": {},
          "thinkingConfig": {}
        },
        "system_instruction": {
          "parts": [
            {
              "text": "{{1.resumen}}"
            }
          ]
        },
        "google_search_context": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "onerror": [
        {
          "id": 903,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 600,
              "y": 150
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "parameters": {
        "__IMTCONN__": null
      },
      "filter": {
        "name": "Ya publicado",
        "conditions": [
          [
            {
              "a": "{{3.result}}",
              "o": "exist"
            },
            {
              "a": "{{3.result}}",
              "b": "NO_PUBLICADO",
              "o": "text:notcontain"
            }
          ]
        ]
      },
      "mapper": {
        "base": "<AIRTABLE_BASE_ID>",
        "table": "<AIRTABLE_TABLE_ID>",
        "fields": [
          "Chat_ID"
        ],
        "formula": "AND({Agente}=\"{{1.agente}}\", {Autor}=\"usuario\", {Chat_ID}!=\"GLOBAL\")",
        "maxRecords": "1000",
        "useColumnId": false,
        "formulaField": "formula"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      },
      "onerror": [
        {
          "id": 904,
          "module": "builtin:Ignore",
          "version": 1,
          "metadata": {
            "designer": {
              "x": 900,
              "y": 150
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 4,
        "rowSeparator": "\n"
      },
      "mapper": {
        "value": "{{4.Chat_ID}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Hay chats activos",
        "conditions": [
          [
            {
              "a": "{{trim(5.text)}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "array": "{{deduplicate(split(5.text; newline))}}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "datastore:GetRecord",
      "version": 1,
      "parameters": {
        "datastore": null
      },
      "filter": {
        "name": "Chat válido",
        "conditions": [
          [
            {
              "a": "{{6.value}}",
              "o": "exist"
            }
          ]
        ]
