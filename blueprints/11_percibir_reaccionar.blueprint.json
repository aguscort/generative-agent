{
  "name": "[Human_proxy] (11/11) | Percibir y reaccionar",
  "flow": [
    {
      "id": 1,
      "module": "datastore:GetRecord",
      "version": 1,
      "parameters": {
        "datastore": null
      },
      "mapper": {
        "key": "perfil|Borja",
        "returnWrapped": false
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      },
